# Versionar somente a aplicação, seus manifestos e o README da raiz.
/*
!/.gitignore
!/README.md
!/backend/
!/frontend/

/backend/*
!/backend/requirements.txt
!/backend/app/
/backend/app/**
!/backend/app/**/
!/backend/app/**/*.py

/frontend/*
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/index.html
!/frontend/vite.config.js
!/frontend/src/
/frontend/src/**
!/frontend/src/**/
!/frontend/src/**/*.js
!/frontend/src/**/*.jsx
!/frontend/src/**/*.css

# Arquivos locais, dependências e artefatos gerados, inclusive dentro do código.
**/node_modules/
**/.venv/
**/.venv-*/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/dist/
**/build/
**/coverage/
**/.coverage
**/.env
**/.env.*
**/*.log
**/.DS_Store
**/Thumbs.db
